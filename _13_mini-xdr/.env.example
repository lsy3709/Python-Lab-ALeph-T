# mini-xdr 환경 설정 예시 — 이 파일을 .env 로 복사해서 값만 바꾸세요.
# 주의: .env 는 절대 커밋하지 않습니다(공개 저장소). 이 예시에는 자리표시자만 둡니다.
# 자리표시자(<YOUR_...>)를 그대로 두면 LLM 없이 규칙 판정 모드로 동작합니다.

# LLM: claude · gemini · none
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=<YOUR_API_KEY>
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_ESCALATE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=<YOUR_GEMINI_MODEL_ID>
MAX_DAILY_LLM_CALLS=200
PROMPT_CACHE_TTL=5m

# 수집(Graylog) — 인증은 GRAYLOG_TOKEN 우선, 없으면 GRAYLOG_USER/GRAYLOG_PASSWORD
GRAYLOG_URL=http://localhost:9000
GRAYLOG_TOKEN=<YOUR_GRAYLOG_TOKEN>
GRAYLOG_USER=<YOUR_GRAYLOG_USER>
GRAYLOG_PASSWORD=<YOUR_GRAYLOG_PASSWORD>
GRAYLOG_QUERY=_exists_:wazuh_rule_id OR _exists_:rule
POLL_INTERVAL_SEC=30
COLLECT_PAGE_SIZE=500
COLLECT_BACKFILL_MIN=1440
COLLECT_OVERLAP_SEC=60
COLLECT_MAX_PAGES=50
CORRELATION_WINDOW_MIN=10

# 행위 이상탐지 — 기준선 학습 기간(일)·최소 표본(미만이면 '기준선 부족')·robust z 임계
BASELINE_DAYS=30
BASELINE_MIN_SAMPLES=30
ANOMALY_Z=3.0

# 저장소(MySQL — mini_xdr 전용 DB·계정)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=xdr
MYSQL_PASSWORD=<YOUR_DB_PASSWORD>
MYSQL_DB=mini_xdr

# 대응(n8n 웹훅)
N8N_WEBHOOK_URL=<YOUR_N8N_WEBHOOK_URL>

# 콘솔(읽기 전용 웹) — 127.0.0.1 이면 이 PC 에서만 접속(컨테이너 안에서는 compose 가 0.0.0.0 으로 바꿈)
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8099

# 웹 UI(/settings)에서 저장하는 AI 키를 DB 에 암호문으로 넣기 위한 열쇠(Fernet, 44자)
# 만들기: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_SECRET_KEY=<YOUR_FERNET_KEY>
